<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Private Crypto Miner</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            background-color: #0f172a;
            color: #ffffff;
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 20px;
            margin: 0;
        }
        .container {
            max-width: 400px;
            margin: auto;
            background: #1e293b;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            margin-top: 30px;
        }
        h2 { color: #38bdf8; }
        .balance {
            font-size: 24px;
            font-weight: bold;
            color: #4ade80;
            margin: 20px 0;
        }
        button {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
        }
        button:hover { background-color: #1d4ed8; }
    </style>
</head>
<body>
    <div class="container">
        <h2>🚀 Private Crypto Miner</h2>
        <p>Admin Control Panel</p>
        <div class="balance" id="balance">0.00000000 BTC</div>
        <p>Status: <span style="color: #4ade80;">Mining Active</span></p>
        <button onclick="startMining()">Start Mining</button>
        <button onclick="withdraw()" style="background-color: #16a34a;">Auto-Withdraw to Binance</button>
    </div>

    <script>
        let btc = 0.00000000;
        
        function startMining() {
            setInterval(() => {
                btc += 0.00000100;
                document.getElementById('balance').innerText = btc.toFixed(8) + " BTC";
            }, 1000);
        }

        async function withdraw() {
            try {
                const response = await fetch('/api/withdraw', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ coin: 'BTC', amount: btc.toFixed(8) })
                });
                const result = await response.json();
                alert(result.message);
            } catch (err) {
                alert("Withdrawal request failed!");
            }
        }

        if (window.Telegram.WebApp) {
            window.Telegram.WebApp.ready();
            window.Telegram.WebApp.expand();
        }
    </script>
</body>
</html>
